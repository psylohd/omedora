 --- Return the currently focused monitor, falling back to the monitor under the cursor.
 ---@return HL.Monitor|nil
 function helpers.get_current_monitor()
+	--- Prefer the monitor of the focused workspace (keyboard focus), which
+	--- aligns with how GUI workspace switchers (e.g. DMS) determine the
+	--- current monitor. This avoids the cursor-position fallback producing a
+	--- different monitor than the one the user is actively typing on.
+	--- Falls back to hl.get_active_monitor() (most recently activated window's
+	--- monitor) and finally hl.get_monitor_at_cursor() only when necessary.
+	local focused_ws = hl.get_active_workspace()
+	if focused_ws and focused_ws.monitor then
+		return focused_ws.monitor
+	end
 	return hl.get_active_monitor() or hl.get_monitor_at_cursor()
 end
 
