#!/usr/bin/env python3
# ws-compact — per-monitor workspace compactor for split-monitor-workspaces.
# Usage: ws-compact [--dry-run]
#
# Algorithm: for each monitor, walk workspaces from base upward.
# For each occupied workspace, if there's an empty slot at or below its
# target position, move its windows down to fill that slot.
# Empty persistent workspaces at lower IDs get filled; occupied workspaces
# shift down to close gaps.
import subprocess, json, sys, os, re

DRY_RUN = "--dry-run" in sys.argv

def run(cmd):
    subprocess.run(cmd, shell=True, capture_output=True)

def hyprctl(cmd):
    r = subprocess.run(f"hyprctl {cmd}", shell=True, capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else None

BASE_OVERRIDE = {}
conf = os.path.expanduser("~/.config/ws-compact.conf")
if os.path.isfile(conf):
    for line in open(conf):
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            m, b = line.split("=", 1)
            if m.strip() and b.strip().isdigit():
                BASE_OVERRIDE[m.strip()] = int(b.strip())

ws_data = json.loads(hyprctl("workspaces -j") or "[]")
clients = json.loads(hyprctl("clients -j") or "[]")

# Per-monitor: list of (ws_id, window_count)
mon_data = {}
for w in ws_data:
    m, wid, name = w.get("monitor",""), w.get("id",0), w.get("name","")
    if not m or wid <= 0 or not re.match(r"^[0-9]+$", name):
        continue
    if m not in mon_data:
        mon_data[m] = {}
    mon_data[m][wid] = w.get("windows", 0)

# Per-monitor: base (override or min ID on that monitor)
monitors = json.loads(hyprctl("monitors -j") or "[]")
mon_base = {}
for m in mon_data:
    if m in BASE_OVERRIDE:
        mon_base[m] = BASE_OVERRIDE[m]
    else:
        mon_base[m] = min(mon_data[m].keys())

def get_clients():
    return json.loads(hyprctl("clients -j") or "[]")

def move_window(addr, target):
    run(f'hyprctl dispatch "hl.dsp.window.move({{ window = \\"address:{addr}\\", workspace = {target}, follow = false }})"')

def switch_workspace(ws_id):
    run(f"hyprctl dispatch 'hl.dsp.focus({{ workspace = {ws_id} }})'")

def compact_monitor(mon, visible_ws_ids):
    base = mon_base.get(mon, 1)
    ws_map = mon_data[mon]  # ws_id -> window_count

    # Gather: slots (IDs >= base) and what each holds
    max_id = max(ws_map.keys())
    slots = []
    for wid in range(base, max_id + 1):
        # Skip this workspace if it's visible AND empty — user has likely
        # cleared it intentionally and doesn't want windows shifted into it.
        if wid in visible_ws_ids and ws_map.get(wid, 0) == 0:
            slots.append({"id": wid, "windows": 0, "skip": True})
        else:
            slots.append({"id": wid, "windows": ws_map.get(wid, 0), "skip": False})

    # Build target layout: occupied workspaces fill non-skipped slots sequentially from base.
    # Skip any slot that is visible and empty — those are preserved as-is.
    occupied_ids = sorted([s["id"] for s in slots if s["windows"] > 0 and not s["skip"]])
    moves = []
    target_idx = 0
    for slot in slots:
        if slot["skip"]:
            continue  # don't use this slot as a destination
        if target_idx >= len(occupied_ids):
            break
        occ_id = occupied_ids[target_idx]
        if occ_id != slot["id"]:
            moves.append((occ_id, slot["id"]))
        target_idx += 1

    if not moves:
        return None

    for src, dst in moves:
        c = get_clients()
        addrs = [x["address"] for x in c if x.get("workspace", {}).get("id") == src]
        if not addrs:
            action = "empty "
        else:
            action = ""
        prefix = "would" if DRY_RUN else "moved"
        if DRY_RUN:
            print(f"ws-compact: {prefix}  WS {action}{src} -> {dst} on {mon}")
        if not DRY_RUN and addrs:
            for addr in addrs:
                move_window(addr, dst)
            print(f"ws-compact: {prefix}  WS {action}{src} -> {dst} on {mon}")
        elif not DRY_RUN and not addrs:
            print(f"ws-compact: {prefix}  WS {action}{src} -> {dst} on {mon}")

    # Return the last destination workspace so caller can follow
    return moves[-1][1] if moves else None

def main():
    # Capture active workspace per monitor BEFORE moving anything
    active_ws = {}  # mon -> ws_id
    for m in monitors:
        active_ws[m["name"]] = m.get("activeWorkspace", {}).get("id", None)

    # Collect all workspaces currently visible on any monitor
    visible_ws_ids = {wid for wid in active_ws.values() if wid is not None}

    # Execute moves — collect actual moves for follow-switch
    all_moves = {}  # mon -> [(src, dst), ...]
    for mon in sorted(mon_data.keys()):
        result = compact_monitor(mon, visible_ws_ids)
        # compact_monitor returns last destination ws id, but we need all moves
        # Reconstruct from mon_data and visible_ws_ids (already done below, but
        # we need the actual executed moves which compact_monitor prints but
        # doesn't return. Since DRY_RUN and non-DRY_RUN both print, we rely on
        # the move list built in compact_monitor. For correctness, we re-build
        # the moves here using the same skip logic so the follow-switch is accurate.
        base = mon_base.get(mon, 1)
        ws_map = mon_data[mon]
        max_id = max(ws_map.keys())
        slots = []
        for wid in range(base, max_id + 1):
            if wid in visible_ws_ids and ws_map.get(wid, 0) == 0:
                slots.append({"id": wid, "windows": 0, "skip": True})
            else:
                slots.append({"id": wid, "windows": ws_map.get(wid, 0), "skip": False})
        occupied_ids = sorted([s["id"] for s in slots if s["windows"] > 0 and not s["skip"]])
        moves = []
        target_idx = 0
        for slot in slots:
            if slot["skip"]:
                continue
            if target_idx >= len(occupied_ids):
                break
            occ_id = occupied_ids[target_idx]
            if occ_id != slot["id"]:
                moves.append((occ_id, slot["id"]))
            target_idx += 1
        all_moves[mon] = moves

    # Switch to the destination workspace on each monitor IF the active
    # workspace was one of the sources that got moved there.
    if not DRY_RUN:
        for mon in sorted(all_moves.keys()):
            cur = active_ws.get(mon)
            moves = all_moves[mon]
            for src, dst in moves:
                if cur == src:
                    switch_workspace(dst)
                    print(f"ws-compact: follow workspace to {dst} on {mon}")
                    break  # only one switch per monitor

if __name__ == "__main__":
    main()
