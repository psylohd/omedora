#!/usr/bin/env python3
# ws-compact-watch — background daemon that polls Hyprland workspace state
# and runs ws-compact when any workspace becomes empty.
# Started via exec_once in startup.lua.
import subprocess, time, json, os

HYPRCTL = os.path.expanduser("~/.local/bin/ws-compact")
POLL_INTERVAL = 5.0  # seconds between state checks

def run(cmd):
    subprocess.run(cmd, shell=True, capture_output=True)

def get_workspace_window_counts():
    r = subprocess.run("hyprctl workspaces -j", shell=True, capture_output=True, text=True)
    if r.returncode != 0:
        return {}
    try:
        return {w["id"]: w["windows"] for w in json.loads(r.stdout)}
    except Exception:
        return {}

def main():
    prev = get_workspace_window_counts()
    while True:
        time.sleep(POLL_INTERVAL)
        curr = get_workspace_window_counts()
        # Check if any workspace went from >0 to 0 windows
        for ws_id, count in curr.items():
            prev_count = prev.get(ws_id, 0)
            if prev_count > 0 and count == 0:
                # Workspace just emptied — compact
                run(HYPRCTL)
                break
        prev = curr

if __name__ == "__main__":
    main()
