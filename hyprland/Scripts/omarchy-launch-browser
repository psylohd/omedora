#!/bin/bash
# Launch the XDG default browser (set via xdg-settings / xdg-mime).
# Pass a URL as the first argument; --private forces a private window.

default_browser=$(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null)
if [[ -z $default_browser ]]; then
  default_browser=$(xdg-mime query default x-scheme-handler/https 2>/dev/null)
fi

if [[ -z $default_browser ]]; then
  notify-send -a "hyprland" -u critical "No default browser set" \
    "Set one with: xdg-settings set default-web-browser <file.desktop>"
  exit 1
fi

# Find the desktop file.
desktop_file=""
for dir in ~/.local/share/applications \
            ~/.nix-profile/share/applications \
            /usr/share/applications \
            /var/lib/flatpak/exports/share/applications; do
  if [[ -f "${dir}/${default_browser}" ]]; then
    desktop_file="${dir}/${default_browser}"
    break
  fi
done

if [[ -z $desktop_file ]]; then
  notify-send -a "hyprland" -u critical "Can't find ${default_browser}" "Desktop file not found."
  exit 1
fi

# Extract the app ID from the desktop filename (e.g. app.zen_browser.zen.desktop → app.zen_browser.zen)
app_id="${default_browser%.desktop}"

# Check if it's a flatpak by looking for flatpak in the Exec line or checking the file path
is_flatpak=false
if grep -q "flatpak" "${desktop_file}"; then
  is_flatpak=true
fi

args=("$@")
for i in "${!args[@]}"; do
  if [[ ${args[$i]} == "--private" ]]; then
    unset 'args[i]'
  fi
done

# If the default is dms-open (DMS URL picker) and no URL was passed, the
# dms-open handler has nothing to open and exits with an error. Bypass it and
# launch the configured browser (Zen) directly via flatpak.
if [[ "${app_id}" == "dms-open" && ${#args[@]} -eq 0 ]]; then
  if [[ -f /var/lib/flatpak/exports/share/applications/app.zen_browser.zen.desktop ]]; then
    flatpak run app.zen_browser.zen &
  else
    notify-send -a "hyprland" -u critical "Zen Browser not found" "The Zen Browser flatpak is not installed."
  fi
  exit 0
fi

if $is_flatpak; then
  flatpak run "${app_id}" "${args[@]}" &
else
  gtk-launch "${app_id}" "${args[@]}" &
fi
