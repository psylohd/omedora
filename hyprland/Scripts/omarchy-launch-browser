#!/bin/bash
# Launch the XDG default browser (set via xdg-settings / xdg-mime).
# Pass a URL as the first argument; --private forces a private window.

default_browser=$(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null)
if [[ -z $default_browser ]]; then
  default_browser=$(xdg-mime query default x-scheme-handler/https 2>/dev/null)
fi

if [[ -z $default_browser ]]; then
  notify-send -a "hyprland" -u critical "No default browser set" \
    "Set one with: xdg-settings set default-web-browser <file.desktop>"
  exit 1
fi

browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' \
  {~/.local,~/.nix-profile,/usr}/share/applications/"$default_browser" 2>/dev/null | head -1)

if [[ -z $browser_exec ]]; then
  notify-send -a "hyprland" -u critical "Can't read $default_browser" "No Exec= line found."
  exit 1
fi

# Choose the right private flag per browser family.
if "$browser_exec" --help 2>/dev/null | grep -q MOZ_LOG; then
  private_flag="--private-window"
elif [[ $browser_exec =~ edge ]]; then
  private_flag="--inprivate"
else
  private_flag="--incognito"
fi

args=("$@")
for i in "${!args[@]}"; do
  if [[ ${args[$i]} == "--private" ]]; then
    args[$i]="$private_flag"
  fi
done

systemd-run --user --quiet --collect --unit="omarchy-browser-$(date +%s%N)" \
  --property=StandardOutput=null --property=StandardError=null \
  "$browser_exec" "${args[@]}" &
disown