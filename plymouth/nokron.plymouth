[Plymouth Theme]
Name=Nokron
Description=ASCII-style FEDORA wordmark on Fedora-blue background, Plymouth spin/script hybrid.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/nokron
ScriptFile=/usr/share/plymouth/themes/nokron/nokron.script
ConsoleLogBackgroundColor=0x0b3d91
MonospaceFont=Cantarell 11
Font=Cantarell 11
